---
// Subpage hero: mono kicker + display heading + short intro.
interface Props {
  label: string;
  heading: string;
}
const { label, heading } = Astro.props;
---
<section class="mx-auto max-w-7xl px-4 pt-36 pb-12 sm:px-6 md:pt-44">
  <p class="label text-xs text-accent">{label}</p>
  <h1 class="display mt-4 text-5xl sm:text-7xl">{heading}</h1>
  <div class="mt-6 max-w-xl text-lg text-paper/80">
    <slot />
  </div>
</section>
