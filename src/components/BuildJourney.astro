---
// 02 · the build. A pinned stage: the page scrolls, the drawing stays, and
// the PC goes together part by part while the sheet beside it ticks off.
//
// Progress is one number, --p (0→1), set on the section by the script at the
// bottom. Every part and step carries its own start, --s, and works out the
// rest in CSS — see "build journey" in global.css. With reduced motion the
// script never runs, --p is pinned to 1, and the finished machine is shown.
const steps = [
  ['Case',        'It starts with the box. Airflow decides everything that follows.'],
  ['Motherboard', 'The board goes in first. Everything else plugs into it.'],
  ['CPU',         'The brain. Seated once, never forced.'],
  ['Cooler',      'Sized to the chip, not to the price tag.'],
  ['Memory',      'Matched sticks, in the slots that actually run dual-channel.'],
  ['Graphics',    'The part that draws every frame you see.'],
  ['Power',       'Sized with headroom. Cabled so you never see them.'],
  ['Tested',      'Panel on. Stress-tested before it leaves the bench. Yours.'],
];
// Each step owns a slice of the scroll, starting here. The SVG groups below
// use the same values, by index.
const s = steps.map((_, i) => (0.02 + i * 0.12).toFixed(2));
---
<section id="build" data-journey class="journey relative scroll-mt-20" aria-label="How a build goes together">
  <div class="stage sticky top-0 flex h-svh flex-col justify-center px-4 pb-6 pt-16 sm:px-6">
    <div class="mx-auto grid w-full max-w-7xl gap-6 md:grid-cols-2 md:items-center md:gap-12">
      <!-- lg:pl-10 clears the fixed rail on the left, which otherwise lands on the step numbers -->
      <div class="order-2 md:order-1 lg:pl-10">
        <p class="label text-xs text-accent">02 &nbsp;Assembled-Here.//</p>
        <h2 class="display mt-3 text-4xl md:text-6xl">Built By Hand</h2>
        <p class="hint mt-3 hidden text-sm text-paper/60 md:block">Keep scrolling. Every build in the shop goes together the same way.</p>

        <div class="relative mt-5 h-12 md:mt-6 md:h-14">
          {steps.map(([, line], i) => (
            <p class="step-line absolute inset-x-0 top-0 max-w-prose text-base leading-relaxed text-paper/80 md:text-lg" style={`--s:${s[i]}`}>{line}</p>
          ))}
        </div>

        <ol class="mt-3 grid grid-cols-2 gap-x-6 gap-y-1 md:mt-8 md:grid-cols-1 md:gap-y-2">
          {steps.map(([name], i) => (
            <li class="step label flex items-baseline gap-3 text-xs md:text-sm" style={`--s:${s[i]}`}>
              <span class="w-6 text-accent">{String(i + 1).padStart(2, '0')}</span>
              <span class="name">{name}</span>
            </li>
          ))}
        </ol>
      </div>

      <!-- Side-on, panel off: front and fans on the left, rear I/O on the right. -->
      <svg class="order-1 w-full max-h-[40svh] overflow-visible md:order-2 md:max-h-[72svh]" viewBox="0 0 600 520" aria-hidden="true">
        <g class="part part-case" style={`--s:${s[0]}`}>
          <rect class="solid" x="60" y="40" width="480" height="440" rx="4" />
          <circle cx="102" cy="140" r="34" /><circle class="dim" cx="102" cy="140" r="24" /><circle cx="102" cy="140" r="5" />
          <circle cx="102" cy="228" r="34" /><circle class="dim" cx="102" cy="228" r="24" /><circle cx="102" cy="228" r="5" />
          <path d="M60 398H540" />
          <rect class="dim" x="522" y="70" width="18" height="100" />
          <path class="dim" d="M524 250h12M524 270h12M524 290h12M524 310h12M524 330h12" />
        </g>
        <g class="part part-board" style={`--s:${s[1]}`}>
          <rect class="solid" x="200" y="70" width="310" height="320" rx="2" />
          <rect class="dim" x="328" y="118" width="74" height="74" />
          <path class="dim" d="M428 92h9v140h-9zM443 92h9v140h-9zM458 92h9v140h-9zM473 92h9v140h-9z" />
          <rect class="dim" x="215" y="296" width="270" height="8" />
          <rect class="dim" x="250" y="330" width="40" height="40" />
          <rect class="dim" x="497" y="180" width="10" height="36" />
        </g>
        <g class="part part-cpu" style={`--s:${s[2]}`}>
          <rect class="solid" x="336" y="126" width="58" height="58" rx="2" />
          <rect class="dim" x="346" y="136" width="38" height="38" />
        </g>
        <g class="part part-cooler" style={`--s:${s[3]}`}>
          <rect class="solid" x="322" y="76" width="86" height="118" rx="2" />
          <path class="dim" d="M326 88h78M326 98h78M326 108h78M326 118h78M326 128h78M326 138h78M326 148h78M326 158h78M326 168h78M326 178h78" />
          <rect class="solid" x="306" y="82" width="14" height="106" rx="2" />
        </g>
        <g class="part part-ram" style={`--s:${s[4]}`}>
          <rect class="solid" x="442" y="88" width="11" height="148" rx="1" />
          <rect class="solid" x="472" y="88" width="11" height="148" rx="1" />
        </g>
        <g class="part part-gpu" style={`--s:${s[5]}`}>
          <rect class="solid" x="212" y="252" width="300" height="48" rx="3" />
          <circle cx="292" cy="276" r="17" /><circle class="dim" cx="292" cy="276" r="11" /><circle cx="292" cy="276" r="4" />
          <circle cx="384" cy="276" r="17" /><circle class="dim" cx="384" cy="276" r="11" /><circle cx="384" cy="276" r="4" />
          <rect class="solid" x="512" y="246" width="10" height="64" rx="1" />
        </g>
        <g class="part part-psu" style={`--s:${s[6]}`}>
          <rect class="solid" x="330" y="412" width="190" height="56" rx="2" />
          <circle cx="380" cy="440" r="20" /><circle class="dim" cx="380" cy="440" r="13" /><circle cx="380" cy="440" r="4" />
          <path class="dim" d="M420 426h84M420 436h84M420 446h84M420 456h84" />
        </g>
        <g class="part part-panel" style={`--s:${s[7]}`}>
          <rect class="glass" x="60" y="40" width="480" height="440" rx="4" />
          <path class="dim" d="M140 462L330 58" />
        </g>
      </svg>
    </div>
  </div>
</section>

<script>
  // --p: how far the viewport has travelled through the section, 0→1.
  const j = document.querySelector<HTMLElement>('[data-journey]');
  if (j && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const tick = () => {
      const r = j.getBoundingClientRect();
      j.style.setProperty('--p', Math.min(1, Math.max(0, -r.top / (r.height - innerHeight))).toFixed(3));
    };
    addEventListener('scroll', tick, { passive: true });
    addEventListener('resize', tick);
    tick();
  }
</script>
