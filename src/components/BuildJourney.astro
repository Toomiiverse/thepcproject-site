---
// 02 · the build. A pinned stage: the page scrolls, the drawing stays, and
// the PC goes together part by part while the sheet beside it ticks off.
//
// The case is a dual-chamber tower seen through its glass side: board in the
// main chamber, a 360 AIO across the top, three intakes on the chamber wall
// to the right and three more on the floor, the supply in the back chamber
// behind the tray — drawn dashed, because from here you never see it.
// Paint is inline on the shapes; only stroke is inherited (see .journey svg
// in global.css).
//
// Progress is one number, --p (0→1), set on the section by the script at the
// bottom. Every part and step carries its own start, --s, and works out the
// rest in CSS — see "build journey" in global.css. With reduced motion the
// script never runs, --p is pinned to 1, and the finished machine is shown.
const steps = [
  { key: 'case',   name: 'Case',        line: 'It starts with the box. Airflow decides everything that follows.' },
  { key: 'board',  name: 'Motherboard', line: 'The board goes in first. Everything else plugs into it.' },
  { key: 'cpu',    name: 'CPU',         line: 'The brain. Seated once, never forced.' },
  { key: 'cooler', name: 'Cooler',      line: 'Sized to the chip, not to the price tag.' },
  { key: 'ram',    name: 'Memory',      line: 'Matched sticks, in the slots that actually run dual-channel.' },
  { key: 'storage', name: 'Storage',    line: 'An NVMe drive, flat on the board. Nothing to cable, nothing to wait for.' },
  { key: 'gpu',    name: 'Graphics',    line: 'The part that draws every frame you see.' },
  { key: 'psu',    name: 'Power',       line: 'Sized with headroom. Cabled so you never see them.' },
].map((p, i) => ({
  ...p,
  n: String(i + 1).padStart(2, '0'),
  // Each step owns a slice of the scroll, starting here.
  s: (0.02 + i * 0.12).toFixed(2),
}));
// The drawing's groups pick up their start by key.
const S = Object.fromEntries(steps.map((p) => [p.key, `--s:${p.s}`]));
const GO = '/configurator';
---
<section id="build" data-journey class="journey relative scroll-mt-20" aria-label="How a build goes together">
  <div class="stage sticky top-0 flex h-svh flex-col justify-center px-4 pb-6 pt-16 sm:px-6">
    <div class="mx-auto grid w-full max-w-7xl gap-6 md:grid-cols-2 md:items-center md:gap-12">
      <!-- lg:pl-10 clears the fixed rail on the left, which otherwise lands on the step numbers -->
      <div class="order-2 md:order-1 lg:pl-10">
        <p class="label text-xs text-accent">02 &nbsp;Assembled-Here.//</p>
        <h2 class="display mt-3 text-4xl md:text-6xl">Built By Hand</h2>
        <p class="hint mt-3 hidden text-sm text-paper/60 md:block">Keep scrolling. Every build in the shop goes together the same way.</p>

        <div class="relative mt-5 h-12 md:mt-6 md:h-14">
          {steps.map((p) => (
            <p class="step-line absolute inset-x-0 top-0 max-w-prose text-base leading-relaxed text-paper/80 md:text-lg" style={`--s:${p.s}`}>{p.line}</p>
          ))}
        </div>

        <ol class="mt-3 grid grid-cols-2 gap-x-6 gap-y-1 md:mt-8 md:grid-cols-1 md:gap-y-2">
          {steps.map((p) => (
            <li class="step label flex items-baseline gap-3 text-xs md:text-sm" style={`--s:${p.s}`}>
              <span class="w-6 text-accent">{p.n}</span>
              <span class="name">{p.name}</span>
            </li>
          ))}
        </ol>

        <a href={GO} class="label mt-6 inline-block text-sm text-accent hover:underline focus-visible:outline-2 focus-visible:outline-accent md:mt-8">
          Open-The-Configurator &rarr;
        </a>
      </div>

      <!-- Through the glass side: rear on the left, the chamber wall and its intakes on the right. The drawing is a way in too. -->
      <a href={GO} aria-label="Open the PC configurator" class="order-1 block md:order-2">
        <svg class="w-full max-h-[40svh] overflow-visible md:max-h-[72svh]" viewBox="0 0 600 520" aria-hidden="true">
          <g class="part part-case" style={S.case}>
            <rect style="fill:var(--color-ink-2)" x="30" y="40" width="540" height="440" rx="4" />
            <rect x="60" y="480" width="30" height="6" /><rect x="480" y="480" width="30" height="6" />
            <!-- the chamber wall, and the three intakes mounted on it -->
            <path d="M430 40V480" />
            <circle cx="500" cy="130" r="34" /><circle style="stroke-opacity:.4" cx="500" cy="130" r="24" /><circle cx="500" cy="130" r="5" />
            <circle cx="500" cy="210" r="34" /><circle style="stroke-opacity:.4" cx="500" cy="210" r="24" /><circle cx="500" cy="210" r="5" />
            <circle cx="500" cy="290" r="34" /><circle style="stroke-opacity:.4" cx="500" cy="290" r="24" /><circle cx="500" cy="290" r="5" />
            <!-- rear bracket slots, and three intakes on the floor seen edge-on -->
            <path style="stroke-opacity:.4" d="M34 300h12M34 320h12M34 340h12M34 360h12" />
            <rect style="stroke-opacity:.4" x="42" y="446" width="112" height="22" rx="2" />
            <rect style="stroke-opacity:.4" x="168" y="446" width="112" height="22" rx="2" />
            <rect style="stroke-opacity:.4" x="294" y="446" width="112" height="22" rx="2" />
          </g>
          <g class="part part-board" style={S.board}>
            <rect style="fill:var(--color-ink)" x="90" y="106" width="320" height="300" rx="2" />
            <rect style="stroke-opacity:.4" x="96" y="112" width="70" height="58" />
            <rect style="stroke-opacity:.4" x="213" y="146" width="74" height="74" />
            <path style="stroke-opacity:.4" d="M350 134h9v140h-9zM365 134h9v140h-9zM380 134h9v140h-9zM395 134h9v140h-9z" />
            <rect style="stroke-opacity:.4" x="178" y="254" width="114" height="18" rx="1" /><circle style="stroke-opacity:.4" cx="286" cy="263" r="3" />
            <rect style="stroke-opacity:.4" x="100" y="298" width="270" height="8" />
            <rect style="stroke-opacity:.4" x="360" y="366" width="36" height="30" />
            <rect style="stroke-opacity:.4" x="396" y="286" width="10" height="36" />
          </g>
          <g class="part part-cpu" style={S.cpu}>
            <rect style="fill:var(--color-ink-2)" x="221" y="154" width="58" height="58" rx="2" />
            <rect style="stroke-opacity:.4" x="231" y="164" width="38" height="38" />
          </g>
          <g class="part part-cooler" style={S.cooler}>
            <!-- radiator along the top, its fans beneath, the end tank at the right -->
            <rect style="fill:var(--color-ink-2)" x="40" y="48" width="358" height="26" rx="2" />
            <path style="stroke-opacity:.4" d="M60 52v18M80 52v18M100 52v18M120 52v18M140 52v18M160 52v18M180 52v18M200 52v18M220 52v18M240 52v18M260 52v18M280 52v18M300 52v18M320 52v18M340 52v18M360 52v18M380 52v18" />
            <rect style="fill:var(--color-ink-2)" x="398" y="46" width="16" height="70" rx="2" />
            <rect style="stroke-opacity:.4" x="42" y="76" width="110" height="22" rx="2" />
            <rect style="stroke-opacity:.4" x="164" y="76" width="110" height="22" rx="2" />
            <rect style="stroke-opacity:.4" x="286" y="76" width="110" height="22" rx="2" />
            <!-- the block on the chip, and two tubes up to the tank -->
            <path d="M242 152C242 112 320 104 398 104M258 152C258 122 330 112 398 112" />
            <circle style="fill:var(--color-ink-2)" cx="250" cy="183" r="32" /><circle style="stroke-opacity:.4" cx="250" cy="183" r="20" />
          </g>
          <g class="part part-ram" style={S.ram}>
            <rect style="fill:var(--color-ink-2)" x="364" y="130" width="11" height="148" rx="1" />
            <rect style="fill:var(--color-ink-2)" x="394" y="130" width="11" height="148" rx="1" />
          </g>
          <g class="part part-storage" style={S.storage}>
            <rect style="fill:var(--color-ink-2)" x="182" y="258" width="100" height="10" rx="1" />
            <rect style="stroke-opacity:.4" x="190" y="260" width="18" height="6" /><rect style="stroke-opacity:.4" x="214" y="260" width="30" height="6" />
            <circle style="fill:var(--color-ink-2)" cx="286" cy="263" r="3" />
          </g>
          <!-- the card in profile, a 4080 FE: chamfered slab, silver frame top and bottom, the fin stack
               showing through the dark middle, the power connector recessed in the top edge -->
          <g class="part part-gpu" style={S.gpu}>
            <rect style="fill:var(--color-ink-2)" x="32" y="292" width="10" height="70" rx="1" />
            <path style="fill:var(--color-ink-2)" d="M52 296H370L380 306V352L370 362H52L42 352V306Z" />
            <rect style="fill:var(--color-paper);fill-opacity:.12;stroke:none" x="48" y="298" width="326" height="7" />
            <rect style="fill:var(--color-paper);fill-opacity:.12;stroke:none" x="48" y="353" width="326" height="7" />
            <rect style="stroke-opacity:.5" x="150" y="308" width="118" height="42" />
            <path style="stroke-opacity:.4" d="M160 314v30M170 314v30M180 314v30M190 314v30M200 314v30M210 314v30M220 314v30M230 314v30M240 314v30M250 314v30M260 314v30" />
            <rect style="stroke-opacity:.5" x="296" y="296" width="20" height="7" />
          </g>
          <!-- the supply sits in the back chamber, behind the tray: dashed, because it is out of sight -->
          <g class="part part-psu" style={`${S.psu};stroke-dasharray:5 4;stroke-opacity:.7`}>
            <rect x="446" y="392" width="100" height="60" rx="2" />
            <circle cx="476" cy="422" r="18" /><circle cx="476" cy="422" r="4" />
            <path d="M504 406h32M504 416h32M504 426h32M504 436h32" />
          </g>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  // --p: how far the viewport has travelled through the section, 0→1.
  const j = document.querySelector<HTMLElement>('[data-journey]');
  if (j && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const tick = () => {
      const r = j.getBoundingClientRect();
      j.style.setProperty('--p', Math.min(1, Math.max(0, -r.top / (r.height - innerHeight))).toFixed(3));
    };
    addEventListener('scroll', tick, { passive: true });
    addEventListener('resize', tick);
    tick();
  }
</script>
