---
// 02 · the build. A pinned stage: the page scrolls, the drawing stays, and
// the PC goes together part by part while the sheet beside it fills in.
//
// The sheet is the configurator's own layout — its masthead, its tiles
// (corner number, the part, its class) — and every tile, the drawing and the
// button all open the configurator. Each tile's art is the same symbol the
// big drawing uses, cropped to the part's box, so there is one drawing of
// each part. Paint inside the symbols is inline, not classed: class rules never
// reach a <use> clone in Chromium, inherited properties and inline styles do.
//
// Progress is one number, --p (0→1), set on the section by the script at the
// bottom. Every part and tile carries its own start, --s, and works out the
// rest in CSS — see "build journey" in global.css. With reduced motion the
// script never runs, --p is pinned to 1, and the finished machine is shown.
const steps = [
  // key · configurator label · class summary · the line read while it lands · art box (x y w h)
  { key: 'case',   label: 'Case',         sum: 'Mid-tower · Airflow front',     line: 'It starts with the box. Airflow decides everything that follows.', box: [56, 36, 488, 448] },
  { key: 'board',  label: 'Motherboard',  sum: 'ATX · 4 DIMM · x16',            line: 'The board goes in first. Everything else plugs into it.',        box: [136, 66, 333, 328] },
  { key: 'cpu',    label: 'Processor',    sum: '8-core · Boxed',                line: 'The brain. Seated once, never forced.',                           box: [282, 120, 70, 70] },
  { key: 'cooler', label: 'CPU Cooler',   sum: 'Air tower · Mid',               line: 'Sized to the chip, not to the price tag.',                       box: [270, 72, 110, 126] },
  { key: 'ram',    label: 'Memory',       sum: '32 GB · 4 × 8 · Dual-channel', line: 'Matched sticks, in the slots that actually run dual-channel.',   box: [379, 84, 64, 156] },
  { key: 'gpu',    label: 'Graphics',     sum: '12 GB · 1440p / 4K',            line: 'The part that draws every frame you see.',                       box: [58, 242, 396, 68] },
  { key: 'psu',    label: 'Power Supply', sum: '850 W · Gold · Modular',        line: 'Sized with headroom. Cabled so you never see them.',             box: [66, 408, 198, 64] },
  { key: 'panel',  label: 'Tested',       sum: 'Benchmarked · Warrantied',      line: 'Panel on. Stress-tested before it leaves the bench. Yours.',     box: [56, 36, 488, 448] },
].map((p, i) => ({
  ...p,
  n: String(i + 1).padStart(2, '0'),
  // Each step owns a slice of the scroll, starting here.
  s: (0.02 + i * 0.12).toFixed(2),
  vb: p.box.join(' '),
  // The tile art is 36px tall, so a ~1.3px stroke is this many of its units.
  sw: (1.3 * p.box[3] / 36).toFixed(1),
}));
const GO = '/configurator';
---
<section id="build" data-journey class="journey relative scroll-mt-20" aria-label="How a build goes together">
  <div class="stage sticky top-0 flex h-svh flex-col justify-center px-4 pb-6 pt-16 sm:px-6">
    <div class="mx-auto grid w-full max-w-7xl gap-5 md:grid-cols-2 md:items-center md:gap-12">
      <!-- lg:pl-10 clears the fixed rail on the left, which otherwise lands on the tile numbers -->
      <div class="order-2 md:order-1 lg:pl-10">
        <!-- the configurator's masthead -->
        <div class="flex items-end justify-between gap-4 border-b-2 border-white/15 pb-3">
          <div>
            <p class="label text-xs text-accent">02 &nbsp;Assembled-Here.//</p>
            <h2 class="display mt-2 text-4xl md:text-5xl">Built By Hand</h2>
          </div>
          <p class="label hidden text-right text-[10px] leading-relaxed text-muted sm:block">
            The PC Project<br /><span class="text-accent">Official PC Configurator</span>
          </p>
        </div>
        <p class="hint mt-3 hidden text-sm text-paper/60 md:block">Keep scrolling — or click any part to start your own.</p>

        <div class="relative mt-4 h-12 md:h-14">
          {steps.map((p) => (
            <p class="step-line absolute inset-x-0 top-0 max-w-prose text-base leading-relaxed text-paper/80 md:text-lg" style={`--s:${p.s}`}>{p.line}</p>
          ))}
        </div>

        <!-- the sheet: the configurator's tiles, each one a way in -->
        <ol class="mt-3 grid grid-cols-4 gap-2 md:mt-5 md:grid-cols-2">
          {steps.map((p) => (
            <li class="step" style={`--s:${p.s}`}>
              <a href={GO} aria-label={`Open the PC configurator — ${p.label}`}
                 class="tile relative flex h-full min-h-[3.5rem] flex-col justify-end border bg-white/[0.02] p-2 pt-5 transition hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-accent sm:min-h-[5.25rem] sm:p-2.5">
                <span class="label absolute left-2 top-1.5 text-[10px] text-muted">{p.n}</span>
                <svg class="mb-1.5 hidden h-9 w-full sm:block" viewBox={p.vb} style={`stroke-width:${p.sw}`} aria-hidden="true">
                  <use href={`#sym-${p.key}`} x={p.box[0]} y={p.box[1]} width={p.box[2]} height={p.box[3]} />
                </svg>
                <span class="label block text-[9px] leading-tight text-muted">{p.label}</span>
                <span class="name label hidden text-[11px] leading-tight sm:block">{p.sum}</span>
              </a>
            </li>
          ))}
        </ol>

        <a href={GO} class="label mt-4 inline-block rounded-sm bg-accent px-5 py-2.5 text-xs font-medium text-ink transition-colors hover:bg-paper focus-visible:outline-2 focus-visible:outline-paper active:translate-y-px md:mt-6">
          Open-The-Configurator &rarr;
        </a>
      </div>

      <!-- Side-on, panel off, laid out like the bench build in the shop: rear exhaust and I/O on the left,
           three intakes on the right, a raked shroud with the floor fan in its opening. The whole drawing is a way in too. -->
      <a href={GO} aria-label="Open the PC configurator" class="order-1 block md:order-2">
        <svg class="w-full max-h-[38svh] overflow-visible md:max-h-[72svh]" viewBox="0 0 600 520" aria-hidden="true">
          <defs>
            <symbol id="sym-case" viewBox={steps[0].vb}>
              <rect style="fill:var(--color-ink-2)" x="60" y="40" width="480" height="440" rx="4" />
              <!-- rear exhaust, top-left, and the bracket slots below it -->
              <circle cx="104" cy="132" r="32" /><circle style="stroke-opacity:.4" cx="104" cy="132" r="22" /><circle cx="104" cy="132" r="5" />
              <path style="stroke-opacity:.4" d="M64 250h12M64 270h12M64 290h12M64 310h12M64 330h12" />
              <!-- the shroud: a raked top edge, then its front wall; the floor fan sits in the opening -->
              <path d="M60 404L470 378V480" />
              <circle cx="504" cy="432" r="28" /><circle style="stroke-opacity:.4" cx="504" cy="432" r="19" /><circle cx="504" cy="432" r="5" />
              <!-- three front intakes -->
              <circle cx="504" cy="112" r="34" /><circle style="stroke-opacity:.4" cx="504" cy="112" r="24" /><circle cx="504" cy="112" r="5" />
              <circle cx="504" cy="190" r="34" /><circle style="stroke-opacity:.4" cx="504" cy="190" r="24" /><circle cx="504" cy="190" r="5" />
              <circle cx="504" cy="268" r="34" /><circle style="stroke-opacity:.4" cx="504" cy="268" r="24" /><circle cx="504" cy="268" r="5" />
            </symbol>
            <symbol id="sym-board" viewBox={steps[1].vb}>
              <rect style="fill:var(--color-ink)" x="140" y="70" width="325" height="320" rx="2" />
              <rect style="stroke-opacity:.4" x="146" y="76" width="70" height="58" />
              <rect style="stroke-opacity:.4" x="280" y="118" width="74" height="74" />
              <path style="stroke-opacity:.4" d="M384 92h9v140h-9zM399 92h9v140h-9zM414 92h9v140h-9zM429 92h9v140h-9z" />
              <rect style="stroke-opacity:.4" x="155" y="296" width="270" height="8" />
              <rect style="stroke-opacity:.4" x="405" y="330" width="40" height="40" />
              <rect style="stroke-opacity:.4" x="449" y="150" width="10" height="36" />
            </symbol>
            <symbol id="sym-cpu" viewBox={steps[2].vb}>
              <rect style="fill:var(--color-ink-2)" x="288" y="126" width="58" height="58" rx="2" />
              <rect style="stroke-opacity:.4" x="298" y="136" width="38" height="38" />
            </symbol>
            <symbol id="sym-cooler" viewBox={steps[3].vb}>
              <rect style="fill:var(--color-ink-2)" x="274" y="76" width="86" height="118" rx="2" />
              <path style="stroke-opacity:.4" d="M278 88h78M278 98h78M278 108h78M278 118h78M278 128h78M278 138h78M278 148h78M278 158h78M278 168h78M278 178h78" />
              <!-- its fan faces the intakes -->
              <rect style="fill:var(--color-ink-2)" x="362" y="82" width="14" height="106" rx="2" />
            </symbol>
            <symbol id="sym-ram" viewBox={steps[4].vb}>
              <rect style="fill:var(--color-ink-2)" x="383" y="88" width="11" height="148" rx="1" />
              <rect style="fill:var(--color-ink-2)" x="398" y="88" width="11" height="148" rx="1" />
              <rect style="fill:var(--color-ink-2)" x="413" y="88" width="11" height="148" rx="1" />
              <rect style="fill:var(--color-ink-2)" x="428" y="88" width="11" height="148" rx="1" />
            </symbol>
            <symbol id="sym-gpu" viewBox={steps[5].vb}>
              <rect style="fill:var(--color-ink-2)" x="72" y="252" width="378" height="48" rx="3" />
              <circle cx="198" cy="276" r="17" /><circle style="stroke-opacity:.4" cx="198" cy="276" r="11" /><circle cx="198" cy="276" r="4" />
              <circle cx="324" cy="276" r="17" /><circle style="stroke-opacity:.4" cx="324" cy="276" r="11" /><circle cx="324" cy="276" r="4" />
              <rect style="fill:var(--color-ink-2)" x="62" y="246" width="10" height="64" rx="1" />
            </symbol>
            <symbol id="sym-psu" viewBox={steps[6].vb}>
              <rect style="fill:var(--color-ink-2)" x="70" y="412" width="190" height="56" rx="2" />
              <circle cx="120" cy="440" r="20" /><circle style="stroke-opacity:.4" cx="120" cy="440" r="13" /><circle cx="120" cy="440" r="4" />
              <path style="stroke-opacity:.4" d="M160 426h84M160 436h84M160 446h84M160 456h84" />
            </symbol>
            <symbol id="sym-panel" viewBox={steps[7].vb}>
              <rect style="fill:var(--color-paper);fill-opacity:.04" x="60" y="40" width="480" height="440" rx="4" />
              <path style="stroke-opacity:.4" d="M140 462L330 58" />
            </symbol>
          </defs>
          {steps.map((p) => (
            <g class={`part part-${p.key}`} style={`--s:${p.s}`}>
              <use href={`#sym-${p.key}`} x={p.box[0]} y={p.box[1]} width={p.box[2]} height={p.box[3]} />
            </g>
          ))}
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  // --p: how far the viewport has travelled through the section, 0→1.
  const j = document.querySelector<HTMLElement>('[data-journey]');
  if (j && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const tick = () => {
      const r = j.getBoundingClientRect();
      j.style.setProperty('--p', Math.min(1, Math.max(0, -r.top / (r.height - innerHeight))).toFixed(3));
    };
    addEventListener('scroll', tick, { passive: true });
    addEventListener('resize', tick);
    tick();
  }
</script>
