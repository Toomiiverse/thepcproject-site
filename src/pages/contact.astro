---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Contact | The PC Project">
  <PageHero label="See-Us-In-Store.//" heading="Contact">
    <p>Walk in for a quote on the spot, or email us and we'll get back to you.</p>
  </PageHero>

  <section class="mx-auto max-w-7xl px-4 pb-24 sm:px-6">
    <div class="reveal grid gap-10 md:grid-cols-2">
      <div class="space-y-6">
        <div>
          <h2 class="label text-xs text-muted">Address.</h2>
          <p class="mt-1 text-lg">2/62 Fitzgerald Street, Northbridge 6003</p>
        </div>
        <div>
          <h2 class="label text-xs text-muted">Email.</h2>
          <p class="mt-1 text-lg">
            <a href="mailto:contact@thepcproject.com.au" class="hover:text-accent">contact@thepcproject.com.au</a>
          </p>
        </div>
        <div>
          <h2 class="label text-xs text-muted">Hours.</h2>
          <dl class="mt-1 max-w-xs text-lg">
            <div class="flex justify-between"><dt>Mon &ndash; Fri</dt><dd>9am &ndash; 6pm</dd></div>
            <div class="flex justify-between"><dt>Sat</dt><dd>10am &ndash; 5pm</dd></div>
            <div class="flex justify-between"><dt>Sun</dt><dd class="text-muted">Closed</dd></div>
          </dl>
        </div>
        <a href="mailto:contact@thepcproject.com.au?subject=Quote%20request" class="label inline-block rounded-sm bg-accent px-6 py-3 text-sm font-medium text-ink transition-colors hover:bg-paper focus-visible:outline-2 focus-visible:outline-paper active:translate-y-px">
          Get-A-Quote
        </a>
      </div>
      <iframe
        title="Map: The PC Project, 2/62 Fitzgerald Street, Northbridge"
        src="https://www.google.com/maps?q=2%2F62+Fitzgerald+Street,+Northbridge+WA+6003&output=embed"
        class="min-h-96 w-full rounded-sm border border-white/10"
        loading="lazy"
      ></iframe>
    </div>
  </section>
</Base>
