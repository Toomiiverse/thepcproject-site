---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { mapsEmbedSrc, site } from '../data/site-config';
---
<Base title="Contact | The PC Project">
  <PageHero label="See-Us-In-Store.//" heading="Contact">
    <p>Walk in for a quote on the spot, or email us and we'll get back to you.</p>
  </PageHero>

  <section class="mx-auto max-w-7xl px-4 pb-24 sm:px-6">
    <div class="reveal grid gap-10 md:grid-cols-2">
      <div class="space-y-6">
        <div>
          <h2 class="label text-xs text-muted">Address.</h2>
          <p class="mt-1 text-lg">{site.address.short}</p>
        </div>
        <div>
          <h2 class="label text-xs text-muted">Email.</h2>
          <p class="mt-1 text-lg">
            <a href={`mailto:${site.email}`} class="hover:text-accent">{site.email}</a>
          </p>
        </div>
        <div>
          <h2 class="label text-xs text-muted">Hours.</h2>
          <dl class="mt-1 max-w-xs text-lg">
            {site.hours.map((h) => (
              <div class="flex justify-between"><dt>{h.label}</dt><dd class={h.muted ? 'text-muted' : undefined}>{h.value}</dd></div>
            ))}
          </dl>
        </div>
        <div class="flex flex-wrap gap-4">
          <a href={`mailto:${site.email}?subject=Quote%20request`} class="label inline-block rounded-sm bg-accent px-6 py-3 text-sm font-medium text-ink transition-colors hover:bg-paper focus-visible:outline-2 focus-visible:outline-paper active:translate-y-px">
            Get-A-Quote
          </a>
          <a href="/book" class="label inline-block rounded-sm border border-white/20 px-6 py-3 text-sm text-paper transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-accent active:translate-y-px">
            Book-A-Service
          </a>
        </div>
      </div>
      <iframe
        title={`Map: ${site.name}, ${site.address.street}, ${site.address.suburb}`}
        src={mapsEmbedSrc()}
        class="min-h-96 w-full rounded-sm border border-white/10"
        loading="lazy"
      ></iframe>
    </div>
  </section>
</Base>
