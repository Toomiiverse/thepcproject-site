---
import Base from '../layouts/Base.astro';
---
<Base
  title="Configurator | The PC Project"
  description="Configure a custom PC and request a quote from The PC Project, Northbridge."
  embed
>
  <iframe
    id="builder"
    title="Custom PC builder"
    class="fixed inset-0 h-dvh w-full border-0 bg-ink"
    src="about:blank"
  ></iframe>
  <p class="sr-only">
    If the builder does not load, email contact@thepcproject.com.au or visit us at 2/62 Fitzgerald Street, Northbridge.
  </p>
  <script>
    import { builderFrameSrc } from '../lib/builderFrame.ts';
    const el = document.getElementById('builder');
    if (el instanceof HTMLIFrameElement) {
      el.src = builderFrameSrc(window.location);
    }
  </script>
</Base>
