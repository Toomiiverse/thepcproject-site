---
import Base from '../layouts/Base.astro';
---
<Base
  title="Configurator | The PC Project"
  description="Configure a custom PC and request a quote from The PC Project, Northbridge."
  embed
>
  <iframe
    id="builder"
    title="Custom PC builder"
    class="fixed inset-x-0 bottom-0 top-14 w-full border-0 bg-ink"
    src="about:blank"
  ></iframe>
  <p class="sr-only">
    If the builder does not load, email contact@thepcproject.com.au or visit us at 2/62 Fitzgerald Street, Northbridge.
  </p>
  <script>
    const el = document.getElementById('builder');
    if (el instanceof HTMLIFrameElement) {
      const { protocol, hostname, port } = window.location;
      // Shop preview serves the site on :8090 and the builder on :8091.
      // Public (no port) uses /builder/ reverse-proxied on the same host.
      // poster=1 selects the build-sheet configurator. The older step-by-step
      // quote flow is still on the same deployment without it.
      const q = '?embed=1&poster=1';
      el.src =
        port === '8090'
          ? `${protocol}//${hostname}:8091/${q}`
          : `${protocol}//${hostname}/builder/${q}`;
    }
  </script>
</Base>
