---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

// 01 · a custom PC: the four steps every build goes through.
const steps = [
  { num: '01', label: 'Consult.//', heading: 'Talk It Through', body: 'Come in-store or email us. We work out what the machine is for, what it should look like, and what it should cost - exact numbers, upfront.' },
  { num: '02', label: 'Design.//', heading: 'Plan The Build', body: 'We research the best parts and deals inside your budget, then handle all procurement. You approve the final spec before anything is ordered.' },
  { num: '03', label: 'Build.//', heading: 'Handcrafted', body: 'Assembled around your vision, style, and performance needs - cable management and thermals included, not extra.' },
  { num: '04', label: 'Deliver.//', heading: 'Tested & Warrantied', body: 'Every build is benchmarked before handover and covered by our Zero-Failure Initiative warranty. Local delivery as far as Bunbury.' },
];

// 02 · a themed PC: what the extra work actually is.
const themedNotes = [
  { heading: 'Built-Around-Something', body: 'A character, a series, a colour, a game. The machine is designed around it from the case out, not finished with a sticker.' },
  { heading: 'Matched-End-To-End', body: 'Case, lighting, cables, fans and panel art chosen together, so the finished PC reads as one thing rather than a parts list.' },
  { heading: 'Signed-And-Numbered', body: 'Every themed build leaves with its own numbered plaque. Yours is the only one wearing that number.' },
];

// 01 · custom builds off the bench.
const customBuilds = [
  { src: '/images/custom-cyan.jpg',  alt: 'A dual-chamber build lit cyan, standing in front of an illuminated display' },
  { src: '/images/custom-white.jpg', alt: 'A white case with rainbow-lit fans and a numbered The PC Project plaque on the glass' },
  { src: '/images/custom-blue.jpg',  alt: 'A black tower with five blue-lit fans, an illuminated display behind it' },
  { src: '/images/custom-mono.jpg',  alt: 'A white compact build with white fans and a Radeon card, on the shop shelf' },
  { src: '/images/custom-lian.jpg',  alt: 'A close look at a white build inside: an AIO block, white fans and routed cabling' },
  { src: '/images/custom-desk.jpg',  alt: 'A finished build lit teal, its monitor showing The PC Project' },
];

// 02 · themed builds, the showcase.
const builds = [
  { src: '/images/themed-lace.jpg',      alt: 'A white build framed in black filigree, a figurine standing beside the graphics card' },
  { src: '/images/themed-crimson.jpg',   alt: 'A black and red build with crimson-lit fans, figurines posed inside the chassis' },
  { src: '/images/themed-android.jpg',   alt: 'A white build with white fans and a figurine seated on the shroud' },
  { src: '/images/themed-cloud.jpg',     alt: 'A white case cut with a cloud pattern, lit blue inside around a Gigabyte card' },
  { src: '/images/themed-rings.jpg',     alt: 'A black case with red-lit rings and themed panel art, figurines along the shroud' },
  { src: '/images/themed-cloud-out.jpg', alt: 'The same cloud-cut white case seen from the front, on a The PC Project backdrop' },
  { src: '/images/themed-frieren.jpg',   alt: 'A pale build with pink and violet lighting, moss along the floor and a figurine beside the card' },
  { src: '/images/themed-violet.jpg',    alt: 'A dark build lit violet, its radiator ring glowing above an EVGA card' },
  { src: '/images/themed-figure.jpg',    alt: 'A close look at figurines inside a red-lit build, framed by a lit ring' },
];
---
<Base title="Custom PCs & Custom Themed PCs | The PC Project">
  <PageHero label="Handcrafted.//" heading="Custom PCs" video="/video/themed.mp4" poster="/video/themed-poster.jpg">
    <p>A PC designed around you, not a spec sheet. Building fee starting from $50 - no markup on parts, no extras for cable management or thermals. Here's how it works.</p>
  </PageHero>

  <!-- ── 01 · custom PCs: the process, plainly ───────────────────── -->
  <section aria-labelledby="custom-heading" class="mx-auto max-w-7xl px-4 pb-24 sm:px-6">
    <p class="label reveal text-xs text-accent">The-Process.//</p>
    <h2 id="custom-heading" class="display reveal mt-4 text-3xl md:text-5xl">Custom PCs</h2>
    <ol class="mt-12 grid gap-12 md:grid-cols-2">
      {steps.map((s) => (
        <li class="reveal">
          <div class="flex items-baseline gap-4">
            <span class="display text-5xl text-accent" aria-hidden="true">{s.num}</span>
            <span class="label text-xs text-muted">{s.label}</span>
          </div>
          <h3 class="display mt-3 text-3xl">{s.heading}</h3>
          <p class="mt-3 max-w-prose text-sm leading-relaxed text-paper/70">{s.body}</p>
        </li>
      ))}
    </ol>
    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {customBuilds.map((b) => (
        <figure class="reveal photo aspect-[4/5] overflow-hidden rounded-sm border border-white/10">
          <img src={b.src} alt={b.alt} loading="lazy" class="h-full w-full object-cover" />
        </figure>
      ))}
    </div>

    <div class="mt-16 flex flex-wrap gap-4">
      <a href="/configurator" class="label rounded-sm bg-accent px-6 py-3 text-sm font-medium text-ink transition-colors hover:bg-paper focus-visible:outline-2 focus-visible:outline-paper active:translate-y-px">
        Start-A-Build
      </a>
      <a href="/contact" class="label rounded-sm border border-white/20 px-6 py-3 text-sm text-paper hover:border-accent hover:text-accent">
        Email-Us
      </a>
    </div>
  </section>

  <!-- ── 02 · custom themed PCs. Its own ground, its own entrance: the
       pieces arrive out of focus and off-axis and settle into place, and
       the heading takes a light across it. See "themed" in global.css. -->
  <section aria-labelledby="themed-heading" class="themed relative overflow-hidden border-y border-white/10 py-24 md:py-32">
    <div class="themed-glow" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
      <p class="label reveal text-xs text-accent">The-Other-Kind.//</p>
      <h2 id="themed-heading" class="display themed-title reveal mt-4 text-4xl md:text-6xl">Custom Themed PCs</h2>
      <p class="reveal mt-6 max-w-prose text-base leading-relaxed text-paper/80">
        The build as the centrepiece. Designed around something you actually care about, matched end to end,
        and finished to be looked at as much as used.
      </p>

      <dl class="reveal mt-12 grid gap-8 md:grid-cols-3">
        {themedNotes.map((n) => (
          <div class="themed-item border-l-2 border-accent pl-4">
            <dt class="label text-sm text-paper">{n.heading}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-paper/70">{n.body}</dd>
          </div>
        ))}
      </dl>

      <div class="reveal mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {builds.map((b) => (
          <figure class="themed-item themed-shot aspect-[4/5] overflow-hidden rounded-sm border border-white/10">
            <img src={b.src} alt={b.alt} loading="lazy" class="h-full w-full object-cover" />
          </figure>
        ))}
      </div>

      <div class="reveal mt-14 flex flex-wrap gap-4">
        <a href="/contact" class="label rounded-sm bg-accent px-6 py-3 text-sm font-medium text-ink transition-colors hover:bg-paper focus-visible:outline-2 focus-visible:outline-paper active:translate-y-px">
          Talk-Themes-With-Us
        </a>
      </div>
    </div>
  </section>
</Base>
