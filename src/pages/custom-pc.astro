---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

// 01 · a custom PC: the four steps every build goes through.
const steps = [
  { num: '01', label: 'Consult.//', heading: 'Talk It Through', body: 'Come in-store, or start with our online configurator. We work out what the machine is actually for, and tailor the build to suit.' },
  { num: '02', label: 'Design.//', heading: 'Plan The Build', body: 'We research the best parts and deals inside your budget, then handle all procurement. You approve the final spec before the build begins.' },
  { num: '03', label: 'Build.//', heading: 'Attention To Detail', body: 'Assembled around what you need most, in the style you want, at the performance you are paying for - cable management and thermals included, not extra.' },
  { num: '04', label: 'Deliver.//', heading: 'Tested & Warrantied', body: 'Every build is benchmarked before handover and covered by our Zero-Failure Initiative warranty. Local delivery as far as Bunbury.' },
];

// 02 · a themed PC: what the extra work actually is.
const themedNotes = [
  { heading: 'Built-Around-Something', body: 'A character, a series, a colour, a game. The machine is designed around it from the case out, not finished with a sticker.' },
  { heading: 'Matched-End-To-End', body: 'Case, lighting, cables, fans and panel art chosen together, so the finished PC reads as one thing rather than a parts list.' },
  { heading: 'Signed-And-Numbered', body: 'Every themed build leaves with its own numbered plaque. Yours is the only one wearing that number.' },
];

// The marquee's two rows. Each is tripled in the markup so the loop never
// shows an edge; only six files are actually fetched.
const rowA = [
  { src: '/images/custom-cyan.jpg',  alt: 'A dual-chamber build lit cyan' },
  { src: '/images/custom-white.jpg', alt: 'A white case with rainbow-lit fans and a numbered plaque' },
  { src: '/images/custom-blue.jpg',  alt: 'A black tower with five blue-lit fans' },
];
const rowB = [
  { src: '/images/custom-mono.jpg',  alt: 'A white compact build with white fans and a Radeon card' },
  { src: '/images/custom-lian.jpg',  alt: 'A close look inside a white build: AIO block, white fans, routed cabling' },
  { src: '/images/custom-desk.jpg',  alt: 'A finished build lit teal, its monitor showing The PC Project' },
];

// 02 · the themed builds. Real projects, each with its own photos; the card
// lays them out according to how many there are.
const cards = [
  { name: 'Project Asuka', shots: [
      { src: '/images/p-asuka-1.jpg', alt: 'A red and black build with EVA-02 panel art and a figurine beside the graphics card' },
      { src: '/images/p-asuka-3.jpg', alt: 'The same build from the front, red-lit through the glass' },
      { src: '/images/p-asuka-2.jpg', alt: 'The build angled on the bench, its red frame and panel art catching the light' },
  ] },
  { name: 'Project Frieren', shots: [
      { src: '/images/p-frieren-2.jpg', alt: 'A white build with violet lighting, moss along the floor and a figurine beside the card' },
      { src: '/images/p-frieren-3.jpg', alt: 'The same build closer in, flowered fans and the figurine' },
      { src: '/images/p-frieren-1.jpg', alt: 'The build with its panel art lit, white flowered fans across the front' },
  ] },
  { name: 'Project NieR Automata', shots: [
      { src: '/images/p-nier-1.jpg', alt: 'A white build framed in black filigree, a figurine seated beside a Radeon card' },
      { src: '/images/p-nier-2.jpg', alt: 'The filigree case in full, white fans and the figurine on the shroud' },
  ] },
  { name: 'Project Sharingan', shots: [
      { src: '/images/p-sharingan-1.jpg', alt: 'A black build with red-lit rings and themed panel art, figurines along the shroud' },
      { src: '/images/p-sharingan-2.jpg', alt: 'Closer in on the red rings and the figurines inside the case' },
  ] },
  { name: 'Project Dark Matter', shots: [
      { src: '/images/p-darkmatter-2.jpg', alt: 'A black build lit violet, its radiator ring glowing above the card' },
      { src: '/images/p-darkmatter-1.jpg', alt: 'The same build wider, violet light across the glass and an EVGA card' },
  ] },
  { name: 'Project Cinnamoroll', shots: [
      { src: '/images/p-cinnamoroll-1.jpg', alt: 'A white and blue build, sleeved cabling and a figurine on the shroud' },
  ] },
];

// The themed intro, revealed a character at a time as the block scrolls through.
const themedIntro = 'The build as the centrepiece. Designed around something you actually care about, matched end to end, and finished to be looked at as much as used.';
---
<Base title="Custom PCs & Custom Themed PCs | The PC Project">
  <PageHero label="Handcrafted.//" heading="Custom PCs" video="/video/themed.mp4" poster="/video/themed-poster.jpg">
    <p>A PC designed around you, not a spec sheet. Building fee starting from $50 - no markup on parts, no extras for cable management or thermals. Here's how it works.</p>
  </PageHero>

  <!-- ── 01 · custom PCs: the process, then the bench on a moving belt ── -->
  <section aria-labelledby="custom-heading" class="mx-auto max-w-7xl px-4 pt-16 sm:px-6 md:pt-28">
    <p class="label reveal text-xs text-accent">How-It-Works.//</p>
    <h2 id="custom-heading" class="display grad reveal mt-4 text-3xl md:text-5xl">The Process</h2>
    <ol class="mt-12 grid gap-12 md:grid-cols-2">
      {steps.map((s) => (
        <li class="reveal">
          <div class="flex items-baseline gap-4">
            <span class="display text-5xl text-accent" aria-hidden="true">{s.num}</span>
            <span class="label text-xs text-muted">{s.label}</span>
          </div>
          <h3 class="display mt-3 text-3xl">{s.heading}</h3>
          <p class="mt-3 max-w-prose text-sm leading-relaxed text-paper/70">{s.body}</p>
        </li>
      ))}
    </ol>
    <div class="mt-16 flex flex-wrap gap-4">
      <a href="/configurator" class="magnet label rounded-sm bg-accent px-6 py-3 text-sm font-medium text-ink transition-colors hover:bg-paper focus-visible:outline-2 focus-visible:outline-paper">
        Start-A-Build
      </a>
    </div>
  </section>

  <!-- The belt: two rows, driven the opposite way by the page's own scroll. -->
  <section aria-label="Builds off the bench" data-sp class="marquee mt-20 overflow-hidden pb-24 md:mt-28">
    <div class="belt belt-a flex gap-3">
      {[...rowA, ...rowA, ...rowA].map((b) => (
        <img src={b.src} alt={b.alt} loading="lazy" class="tile" />
      ))}
    </div>
    <div class="belt belt-b mt-3 flex gap-3">
      {[...rowB, ...rowB, ...rowB].map((b) => (
        <img src={b.src} alt={b.alt} loading="lazy" class="tile" />
      ))}
    </div>
  </section>

  <!-- ── 02 · custom themed PCs. Its own ground, its own entrance, and the
       builds arrive as cards that stack up and settle back as you pass. -->
  <section aria-labelledby="themed-heading" class="themed relative border-t border-white/10 py-24 md:py-32">
    <div class="themed-glow" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
      <p class="label reveal text-xs text-accent">The-Other-Kind.//</p>
      <h2 id="themed-heading" class="display themed-title grad reveal mt-4 text-4xl md:text-6xl">Custom Themed PCs</h2>

      <p data-sp class="chars mt-6 max-w-prose text-base leading-relaxed text-paper/80 md:text-lg">
        {themedIntro.split('').map((ch, i) => (
          <span class="ch" style={`--i:${i}`}>{ch === ' ' ? ' ' : ch}</span>
        ))}
      </p>

      <dl class="reveal mt-12 grid gap-8 md:grid-cols-3">
        {themedNotes.map((n) => (
          <div class="themed-item border-l-2 border-accent pl-4">
            <dt class="label text-sm text-paper">{n.heading}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-paper/70">{n.body}</dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- the stack -->
    <div class="relative mx-auto mt-20 max-w-7xl px-4 sm:px-6 md:mt-28">
      <p class="label reveal text-xs text-accent">Built-And-Delivered.//</p>
      <h3 id="past-work" class="display grad reveal mt-4 text-3xl md:text-5xl">Our Past Work</h3>
    </div>
    <div class="mt-10 px-4 sm:px-6 md:mt-14">
      {cards.map((c, i) => (
        <div data-sp class="card-wrap">
          <article class="card mx-auto max-w-7xl rounded-[40px] border-2 border-[#D7E2EA]/25 bg-ink p-4 sm:rounded-[50px] sm:p-6 md:p-8" style={`--n:${i}`}>
            <div class="px-2 pb-1 md:px-4">
              <h4 class="display text-2xl md:text-4xl">{c.name}</h4>
            </div>
            {c.shots.length === 3 && (
              <div class="mt-5 flex gap-3 md:gap-4">
                <div class="flex w-[40%] flex-col gap-3 md:gap-4">
                  <img src={c.shots[0].src} alt={c.shots[0].alt} loading="lazy" class="shot-a w-full rounded-[28px] object-cover sm:rounded-[40px]" />
                  <img src={c.shots[1].src} alt={c.shots[1].alt} loading="lazy" class="shot-b w-full rounded-[28px] object-cover sm:rounded-[40px]" />
                </div>
                <img src={c.shots[2].src} alt={c.shots[2].alt} loading="lazy" class="shot-tall w-[60%] rounded-[28px] object-cover sm:rounded-[40px]" />
              </div>
            )}
            {c.shots.length === 2 && (
              <div class="mt-5 grid grid-cols-2 gap-3 md:gap-4">
                {c.shots.map((sh) => (
                  <img src={sh.src} alt={sh.alt} loading="lazy" class="shot-pair w-full rounded-[28px] object-cover sm:rounded-[40px]" />
                ))}
              </div>
            )}
            {c.shots.length === 1 && (
              <div class="mt-5">
                <img src={c.shots[0].src} alt={c.shots[0].alt} loading="lazy" class="shot-solo w-full rounded-[28px] object-cover sm:rounded-[40px]" />
              </div>
            )}
          </article>
        </div>
      ))}
    </div>

    <div class="reveal mt-20 flex flex-wrap gap-4 px-4 sm:px-6">
      <a href="/contact" class="magnet label mx-auto rounded-sm bg-accent px-6 py-3 text-sm font-medium text-ink transition-colors hover:bg-paper focus-visible:outline-2 focus-visible:outline-paper">
        Talk-Themes-With-Us
      </a>
    </div>
  </section>

  <style>
    /* Headings take a vertical gradient, muted into paper. */
    .grad {
      background: linear-gradient(180deg, var(--color-muted) 0%, var(--color-paper) 70%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }

    /* ── the belt ──
       --p is how far this section has travelled through the viewport, 0 to 1,
       written by the script below. One row runs with it, the other against. */
    .marquee { --p: 0; }
    .tile {
      width: 180px;
      height: 234px;
      flex: none;
      border-radius: 1rem;
      object-fit: cover;
    }
    @media (min-width: 768px) {
      .tile { width: 260px; height: 338px; }
    }
    .belt { will-change: transform; }
    .belt-a { transform: translateX(calc(var(--p) * 620px - 340px)); }
    .belt-b { transform: translateX(calc(var(--p) * -620px + 40px)); }

    /* ── the intro, a character at a time ── */
    .chars { --p: 0; }
    .ch {
      opacity: calc(0.18 + 0.82 * clamp(0, (var(--p) - var(--i) * 0.0055) * 9, 1));
      transition: opacity 0.1s linear;
    }

    /* ── the stack ──
       The wrapper is what scrolls, so it carries --p; the card inside it is
       the sticky one, and each sticks a little lower than the last so they
       read as a pile. A card shrinks once the next is climbing over it. */
    .card-wrap {
      --p: 0;
      min-height: 74vh;
    }
    .card {
      position: sticky;
      top: calc(5.5rem + var(--n) * 16px);
      transform-origin: top center;
      transform: scale(calc(1 - clamp(0, (var(--p) - 0.5) * 2, 1) * 0.055));
      transition: transform 0.15s linear;
    }
    @media (min-width: 768px) {
      .card { top: calc(7.5rem + var(--n) * 20px); }
    }
    .shot-a { height: clamp(110px, 14vw, 210px); }
    .shot-b { height: clamp(140px, 20vw, 310px); }
    .shot-tall { height: clamp(262px, 34.9vw, 536px); }
    .shot-pair { height: clamp(200px, 26vw, 420px); }
    .shot-solo { height: clamp(220px, 30vw, 480px); }

    @media (prefers-reduced-motion: reduce) {
      .belt-a, .belt-b { transform: none; }
      .marquee { overflow-x: auto; }
      .ch { opacity: 1; transition: none; }
      .card { transform: none; transition: none; position: static; }
      .card-wrap { min-height: 0; }
    }
  </style>

  <script>
    // One listener for every scroll-driven thing on the page: each element
    // marked data-sp gets --p, 0 as its top enters the bottom of the
    // viewport, 1 as its bottom leaves the top.
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) {
      const tracked = [...document.querySelectorAll<HTMLElement>('[data-sp]')];
      const tick = () => {
        const vh = innerHeight;
        for (const el of tracked) {
          const r = el.getBoundingClientRect();
          const p = (vh - r.top) / (r.height + vh);
          el.style.setProperty('--p', Math.min(1, Math.max(0, p)).toFixed(4));
        }
      };
      addEventListener('scroll', tick, { passive: true });
      addEventListener('resize', tick);
      tick();

      // Magnetic buttons: they lean toward the cursor while it is near.
      const PULL = 110;
      for (const el of document.querySelectorAll<HTMLElement>('.magnet')) {
        el.style.willChange = 'transform';
        addEventListener('mousemove', (e) => {
          const r = el.getBoundingClientRect();
          const dx = e.clientX - (r.left + r.width / 2);
          const dy = e.clientY - (r.top + r.height / 2);
          const near = Math.abs(dx) < r.width / 2 + PULL && Math.abs(dy) < r.height / 2 + PULL;
          if (near) {
            el.style.transition = 'transform 0.3s ease-out';
            el.style.transform = `translate3d(${dx / 3.2}px, ${dy / 3.2}px, 0)`;
          } else if (el.style.transform) {
            el.style.transition = 'transform 0.6s ease-in-out';
            el.style.transform = '';
          }
        }, { passive: true });
      }
    }
  </script>
</Base>
