---
import Base from '../layouts/Base.astro';

// Scroll journey: follow one part through the 4-stage QA process.
const stages = [
  {
    num: '01', id: 'stage-01', label: 'Sourcing.//', heading: 'Procurement',
    body: 'Every part starts as a question mark. A trade-in, a bulk lot, a card someone swears "ran fine". It gets logged into inventory with its source and identifying information - traceable from day one.',
    tags: ['Source-Logged', 'Serial-Recorded', 'Inventory-ID'],
  },
  {
    num: '02', id: 'stage-02', label: 'Assessment.//', heading: 'It Gets Documented',
    body: 'Condition is inspected and photographed before anything is powered on. Visible damage, missing components, corrosion, wear - all of it goes on record, not under the rug.',
    tags: ['Photographed', 'Damage-Check', 'Corrosion', 'Wear'],
  },
  {
    num: '03', id: 'stage-03', label: 'Testing.//', heading: 'It Gets Pushed',
    body: 'Now it powers on and earns its keep. Appropriate workloads verify functionality, stability, and performance - benchmarks, stress tests, thermal behaviour. Numbers, not vibes.',
    tags: ['Benchmarked', 'Stress-Tested', 'Thermals', 'Stability'],
  },
  {
    num: '04', id: 'stage-04', label: 'Sign-Off.//', heading: 'The Verdict',
    body: 'Results are recorded and the item is formally marked QA Approved, rejected, or flagged for further investigation. Only approved parts reach the shelf or go into a build.',
    tags: ['Approved', 'Rejected', 'Investigate'],
  },
];

const items = [
  { name: 'CPU', checks: ['Physical condition', 'Pins / contacts', 'Boot & functionality', 'Temperature behaviour', 'Benchmark performance', 'Stability'] },
  { name: 'Motherboard', checks: ['Socket and pins', 'RAM slots', 'PCIe slots', 'Storage interfaces', 'USB / I/O', 'BIOS functionality', 'General stability'] },
  { name: 'RAM', checks: ['Physical condition', 'Capacity detection', 'Frequency / timings', 'Memory testing', 'Stability'] },
  { name: 'GPU', checks: ['Physical condition', 'Display output', 'VRAM detection', 'Benchmark performance', 'Stress testing', 'Temperature / fan behaviour', 'Stability'] },
];
---
<Base title="QA-Assessed Items | The PC Project" description="Follow a pre-owned part through our documented 4-stage QA process: procurement, assessment, benchmark testing, and sign-off.">
  <!-- journey progress rail (desktop) -->
  <nav aria-label="QA stages" class="fixed left-4 top-1/2 z-40 hidden -translate-y-1/2 items-stretch gap-3 lg:flex">
    <div class="relative w-px bg-white/15">
      <div id="journey-fill" class="absolute inset-x-0 top-0 h-full origin-top scale-y-0 bg-accent"></div>
    </div>
    <div class="flex flex-col justify-between gap-8 py-1">
      {stages.map((s) => (
        <a href={'#' + s.id} data-rail-link class="label text-xs text-muted transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-accent">
          {s.num}
        </a>
      ))}
    </div>
  </nav>

  <!-- opening -->
  <section class="relative flex min-h-svh items-center px-4 pt-16 sm:px-6">
    <div class="mx-auto w-full max-w-7xl">
      <p class="label text-xs text-accent">Tested-&amp;-Traceable.//</p>
      <h1 class="display mt-4 text-5xl sm:text-7xl md:text-8xl">
        From Trade-In<br />To Trusted<span class="text-accent">;</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-paper/80">
        Every pre-owned part we sell passes a structured 4-stage QA process before it's approved for resale or a build. This is what happens between a part walking in and a part earning the sticker. Scroll.
      </p>
      <a href="#stage-01" aria-label="Start the journey" class="label mt-12 inline-block animate-bounce text-2xl text-accent focus-visible:outline-2 focus-visible:outline-accent">&darr;</a>
    </div>
  </section>

  <!-- the journey: one stage per viewport, ghost numeral behind -->
  <div id="journey">
    {stages.map((s, i) => (
      <section id={s.id} data-scene class="relative flex min-h-svh scroll-mt-20 items-center overflow-hidden px-4 sm:px-6">
        <span aria-hidden="true" class={`display pointer-events-none absolute top-1/2 -translate-y-1/2 text-[45vw] leading-none text-white/[0.04] select-none lg:text-[28vw] ${i % 2 ? 'left-0' : 'right-0'}`}>
          {s.num}
        </span>
        {i === 0 && (
          <!-- the pick-up: as this stage scrolls through, the van drives out and collects the part -->
          <div aria-hidden="true" class="scene pickup pointer-events-none absolute inset-x-0 bottom-4 px-4 sm:bottom-8 sm:px-6">
            <svg class="mx-auto block w-full max-w-7xl" viewBox="0 0 1000 120">
              <line x1="0" y1="100" x2="1000" y2="100" />
              <line class="dashes" x1="0" y1="110" x2="1000" y2="110" />
              <!-- where the part is waiting -->
              <path d="M860 100V50H930V100" />
              <path d="M852 52L895 30L938 52" />
              <rect x="905" y="76" width="16" height="24" />
              <g class="box-there"><rect x="836" y="84" width="18" height="16" /><path class="dim" d="M836 90h18" /></g>
              <!-- the van, cab forward -->
              <g class="van">
                <path class="body" d="M10 88V52H84L108 66L120 68V88Z" />
                <path class="dim" d="M84 52V66H108" />
                <rect class="dim" x="18" y="58" width="58" height="22" />
                <g class="wheel"><circle class="tyre" cx="32" cy="90" r="10" /><path class="dim" d="M32 82v16M24 90h16" /></g>
                <g class="wheel"><circle class="tyre" cx="100" cy="90" r="10" /><path class="dim" d="M100 82v16M92 90h16" /></g>
                <g class="box-aboard"><rect x="38" y="61" width="18" height="16" /></g>
              </g>
            </svg>
          </div>
        )}
        {i === 1 && (
          <!-- the assessment: the part on the bench, a glass sweeping it, and the record filling in beside it -->
          <div aria-hidden="true" class="scene assess pointer-events-none absolute inset-x-0 bottom-4 px-4 sm:bottom-8 sm:px-6">
            <svg class="mx-auto block w-full max-w-7xl" viewBox="0 0 1000 120">
              <line x1="0" y1="100" x2="1000" y2="100" />
              <!-- the part: a card in profile -->
              <rect class="body" x="110" y="52" width="10" height="44" rx="1" />
              <path class="body" d="M130 58H430L440 68V88L430 96H130L120 88V68Z" />
              <rect class="dim" x="250" y="66" width="80" height="24" />
              <path class="dim" d="M258 70v16M266 70v16M274 70v16M282 70v16M290 70v16M298 70v16M306 70v16M314 70v16M322 70v16" />
              <!-- what the glass finds, as it passes -->
              <g class="mark accent f" style="--t:.2"><circle cx="202" cy="77" r="7" /><circle cx="202" cy="77" r="1.5" /></g>
              <g class="mark accent f" style="--t:.55"><circle cx="293" cy="77" r="7" /><circle cx="293" cy="77" r="1.5" /></g>
              <g class="mark accent f" style="--t:.85"><circle cx="371" cy="77" r="7" /><circle cx="371" cy="77" r="1.5" /></g>
              <!-- the glass -->
              <g class="glass"><circle class="lens" cx="150" cy="66" r="26" /><path d="M169 85L192 108" stroke-width="5" /></g>
              <!-- the record, filling in line by line -->
              <rect class="body" x="620" y="20" width="280" height="80" rx="2" />
              <path class="dim" d="M636 34h120" />
              <g class="rec"><path class="f" style="--t:.1" d="M636 50h200" /><path class="f" style="--t:.28" d="M636 62h150" /><path class="f" style="--t:.46" d="M636 74h220" /><path class="f" style="--t:.64" d="M636 86h130" /></g>
              <g class="tick accent f" style="--t:.9"><path d="M862 36l8 8 16-16" /></g>
            </svg>
          </div>
        )}
        <div class={`mx-auto w-full max-w-7xl ${i % 2 ? 'flex justify-end' : ''}`}>
          <div class="reveal max-w-xl">
            <div class="flex items-baseline gap-4">
              <span class="display text-6xl text-accent md:text-7xl" aria-hidden="true">{s.num}</span>
              <span class="label text-xs text-muted">{s.label}</span>
            </div>
            <h2 class="display mt-4 text-4xl md:text-6xl">{s.heading}</h2>
            <p class="mt-6 text-base leading-relaxed text-paper/80">{s.body}</p>
            <ul class="mt-6 flex flex-wrap gap-2">
              {s.tags.map((t) => (
                <li class="label rounded-sm border border-white/15 px-3 py-1 text-xs text-paper/70">{t}</li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    ))}
  </div>

  <!-- the stamp -->
  <section class="flex min-h-svh items-center px-4 sm:px-6">
    <div class="mx-auto w-full max-w-7xl text-center">
      <p class="label reveal text-xs text-muted">The-Whole-Point.//</p>
      <p class="stamp display mx-auto mt-8 inline-block rotate-[-3deg] border-4 border-accent px-8 py-4 text-4xl text-accent sm:text-6xl md:text-7xl">
        QA-Approved<span class="text-paper">;</span>
      </p>
      <p class="reveal mx-auto mt-10 max-w-xl text-lg text-paper/80">
        Used hardware becomes documented, traceable inventory - not a dusty GPU with a &ldquo;tested&rdquo; sticker.
      </p>
    </div>
  </section>

  <!-- what gets checked, per component -->
  <section class="mx-auto max-w-7xl px-4 pb-24 sm:px-6">
    <p class="label reveal text-xs text-accent">What-We-Check.//</p>
    <h2 class="display reveal mt-4 text-4xl md:text-5xl">Items Covered</h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((item) => (
        <article class="reveal rounded-sm border border-white/10 p-6 transition-colors hover:border-accent">
          <h3 class="display text-2xl">{item.name}</h3>
          <ul class="mt-4 space-y-2">
            {item.checks.map((c) => (
              <li class="flex gap-2 text-sm leading-relaxed text-paper/70">
                <span class="text-accent" aria-hidden="true">&#47;&#47;</span>{c}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <div class="mt-12">
      <a href="/contact" class="label rounded-sm bg-accent px-6 py-3 text-sm font-medium text-ink transition-colors hover:bg-paper focus-visible:outline-2 focus-visible:outline-paper active:translate-y-px">
        Ask-About-QA-Stock
      </a>
    </div>
  </section>

  <style>
    /* stamp slams in when revealed */
    .stamp {
      opacity: 0;
      transform: rotate(-3deg) scale(1.6);
      transition: opacity 0.35s ease-out, transform 0.35s cubic-bezier(0.2, 0.8, 0.3, 1.2);
    }
    .stamp.in {
      opacity: 1;
      transform: rotate(-3deg) scale(1);
    }
    @media (prefers-reduced-motion: reduce) {
      .stamp { opacity: 1; transform: rotate(-3deg); transition: none; }
    }

    /* the scenes: --p is how far a stage has scrolled through the viewport (0 as its top
       enters at the bottom, 1 as its bottom leaves at the top). Each scene runs along the
       foot of its stage, on screen from 0.5 until it slides under the header near 0.9,
       so everything happens inside that window. */
    [data-scene] { --p: 0; }
    .scene { color: var(--color-paper); }
    .scene svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .scene .dim { stroke-opacity: 0.4; }
    .scene .body { fill: var(--color-ink-2); }
    .scene .accent { color: var(--color-accent); }
    .pickup .van, .pickup .wheel, .pickup .box-there, .pickup .box-aboard,
    .assess .glass, .assess .mark, .assess .rec .f, .assess .tick {
      transform-box: fill-box;
      transform-origin: center;
      transition: transform 0.15s linear, opacity 0.15s linear;
    }

    /* 01, the pick-up: the van drives out, and the part comes aboard before the stage leaves */
    .pickup {
      --drive: clamp(0, calc((var(--p) - 0.5) / 0.28), 1);
      --pick: clamp(0, calc((var(--p) - 0.79) / 0.07), 1);
    }
    .pickup .dashes { stroke-opacity: 0.4; stroke-dasharray: 14 12; }
    .pickup .tyre { fill: var(--color-ink-2); }
    .pickup .box-there, .pickup .box-aboard { color: var(--color-accent); }
    .pickup .van { transform: translateX(calc(var(--drive) * 700px)); }
    .pickup .wheel { transform: rotate(calc(var(--drive) * 1080deg)); }
    .pickup .box-there { opacity: calc(1 - var(--pick)); }
    .pickup .box-aboard { opacity: var(--pick); transform: translateY(calc(-16px * (1 - var(--pick)))); }

    /* 02, the assessment: the glass sweeps the part; each find, each line of the record and
       the tick have their own moment in the sweep, --t */
    .assess { --sweep: clamp(0, calc((var(--p) - 0.5) / 0.3), 1); }
    .assess .lens { fill: var(--color-paper); fill-opacity: 0.06; }
    .assess .glass { transform: translateX(calc(var(--sweep) * 260px)); }
    .assess .f { --t: 0; --f: clamp(0, calc((var(--sweep) - var(--t)) / 0.08), 1); }
    .assess .mark { opacity: var(--f); transform: scale(calc(1.6 - 0.6 * var(--f))); }
    .assess .rec .f { transform: scaleX(var(--f)); transform-origin: left center; }
    .assess .tick { opacity: var(--f); transform: scale(calc(1.4 - 0.4 * var(--f))); }

    @media (prefers-reduced-motion: reduce) {
      [data-scene] { --p: 1 !important; }
      .pickup .van, .pickup .wheel, .pickup .box-there, .pickup .box-aboard,
      .assess .glass, .assess .mark, .assess .rec .f, .assess .tick { transition: none; }
    }
  </style>

  <script>
    // Progress rail fill: fraction of the journey block scrolled past mid-viewport.
    const fill = document.getElementById('journey-fill');
    const journey = document.getElementById('journey');
    if (fill && journey) {
      const scenes = document.querySelectorAll<HTMLElement>('[data-scene]');
      const update = () => {
        const r = journey.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (innerHeight / 2 - r.top) / r.height));
        fill.style.transform = `scaleY(${p})`;
        scenes.forEach((s) => {
          const t = s.getBoundingClientRect();
          s.style.setProperty('--p', Math.min(1, Math.max(0, (innerHeight - t.top) / (t.height + innerHeight))).toFixed(3));
        });
      };
      addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
      update();
    }
    // The stamp reuses the reveal observer in Base via the same 'in' class.
    const stamp = document.querySelector('.stamp');
    if (stamp) {
      new IntersectionObserver((entries, io) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.disconnect(); } });
      }, { threshold: 0.5 }).observe(stamp);
    }
  </script>
</Base>
