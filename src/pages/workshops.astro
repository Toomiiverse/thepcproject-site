---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="PC Workshops | The PC Project">
  <PageHero label="Learn-The-Craft.//" heading="Workshops">
    <p>Bridging the gap between prebuilt PCs and the custom build experience - build your own machine with our guidance and tools.</p>
  </PageHero>

  <!-- the workshop itself: what it is, what it costs, how long it takes -->
  <section aria-labelledby="build-your-own" class="mx-auto max-w-7xl px-4 pb-16 sm:px-6">
    <div class="reveal rounded-sm border border-accent/40 bg-white/[0.02] p-6 sm:p-8">
      <p class="label text-xs text-accent">Build-Your-Own.//</p>
      <h2 id="build-your-own" class="display mt-2 text-3xl md:text-4xl">From Parts To First Boot</h2>
      <p class="mt-4 max-w-prose text-base leading-relaxed text-paper/80">
        Always wanted to build your own PC but never knew where to start? We run PC workshops that show you how
        to build a PC from the very start all the way to the first boot-up, and you're guided through the whole
        build by one of our Master PC Builders.
      </p>
      <dl class="mt-8 grid gap-6 sm:grid-cols-3">
        <div class="border-l-2 border-accent pl-4">
          <dt class="label text-xs text-muted">Cost</dt>
          <dd class="display mt-1 text-3xl">$100</dd>
        </div>
        <div class="border-l-2 border-accent pl-4">
          <dt class="label text-xs text-muted">Takes</dt>
          <dd class="display mt-1 text-3xl">2-3 hrs</dd>
        </div>
        <div class="border-l-2 border-accent pl-4">
          <dt class="label text-xs text-muted">With</dt>
          <dd class="mt-1 text-sm leading-relaxed text-paper">One of our Master PC Builders, beside you the whole way.</dd>
        </div>
      </dl>
      <a href="/contact" class="label mt-8 inline-block rounded-sm bg-accent px-6 py-3 text-sm font-medium text-ink transition-colors hover:bg-paper focus-visible:outline-2 focus-visible:outline-paper active:translate-y-px">
        Book-A-Workshop
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-24 sm:px-6">
    <div class="grid items-center gap-10 md:grid-cols-2">
      <div class="reveal space-y-6">
        <div class="border-l-2 border-accent pl-4">
          <h2 class="label text-sm text-paper">Guided-Builds</h2>
          <p class="mt-2 text-sm leading-relaxed text-paper/70">Assemble your own PC at our bench with an experienced builder beside you. You leave with a machine you built and understand.</p>
        </div>
        <div class="border-l-2 border-accent pl-4">
          <h2 class="label text-sm text-paper">Tech-Support</h2>
          <p class="mt-2 text-sm leading-relaxed text-paper/70">Expert help to diagnose, fix, and optimise your system - bring it in for assessment at honest prices.</p>
        </div>
        <div class="border-l-2 border-accent pl-4">
          <h2 class="label text-sm text-paper">Events</h2>
          <p class="mt-2 text-sm leading-relaxed text-paper/70">Upcoming esports events hosted by The PC Project. Announced in-store and on socials.</p>
        </div>
        <a href="/contact" class="label inline-block rounded-sm bg-accent px-6 py-3 text-sm font-medium text-ink transition-colors hover:bg-paper focus-visible:outline-2 focus-visible:outline-paper active:translate-y-px">
          Register-Interest
        </a>
      </div>
      <div class="reveal aspect-[4/3] overflow-hidden rounded-sm border border-white/10">
        <img src="/images/workshop-bench.jpg" alt="A guided PC build in progress on the workshop bench" loading="lazy" class="h-full w-full object-cover" />
      </div>
    </div>
  </section>
</Base>
