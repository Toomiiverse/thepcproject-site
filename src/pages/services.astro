---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

// Bench work. No prices here except the one already published on /level-up -
// add them to this list when they are set.
const services = [
  { name: 'CPU-Repaste', body: 'Old paste comes off, the cooler is cleaned and reseated with fresh compound. The usual fix for a chip running hotter and louder than it used to.' },
  { name: 'GPU-Swap', body: 'Out with the old card, in with the new. We check the supply and clearances first, fit it, and test the machine before it goes back to you.', note: '$50' },
  { name: 'PC-Clean', body: 'Dust out of the filters, fans, radiator and heatsinks, cables tidied on the way through. Airflow back to what it was on day one.' },
  { name: 'Upgrades', body: 'Memory, storage, cooling, a bigger supply. We check the new part suits the board and the case before anything is ordered.' },
  { name: 'Diagnostics', body: 'It will not boot, it crashes, it throttles, it is louder than it should be. We find out why and tell you what it will cost to fix.' },
  { name: 'Repairs', body: 'Faulty parts identified, replaced and tested. If it is under a manufacturer warranty we will tell you rather than charge you for it.' },
];

const promises = [
  { heading: 'We-Quote-First', body: 'We assess the machine and tell you the price before anything is touched. If we open it up and the job turns out bigger than quoted, we stop and come back to you.' },
  { heading: 'Tested-Before-It-Leaves', body: 'Anything we work on is run and checked on the bench before you collect it, the same as a build.' },
  { heading: 'Thirty-Day-Workmanship', body: 'Our work is covered for thirty days. If it is not right, bring it back and we will put it right at no charge.' },
];
---
<Base
  title="Services | The PC Project"
  description="Repastes, GPU swaps, cleaning, upgrades, diagnostics and repairs in Northbridge. We assess and quote before any work starts."
>
  <PageHero label="On-The-Bench.//" heading="Services">
    <p>Repastes, part swaps, cleaning, upgrades and repairs - on any machine, not just the ones we built. We assess it and quote before anything is touched.</p>
  </PageHero>

  <article class="mx-auto max-w-7xl px-4 pb-24 sm:px-6">
    <section aria-labelledby="what">
      <p class="label reveal text-xs text-accent">What-We-Do.//</p>
      <h2 id="what" class="display grad reveal mt-4 text-3xl md:text-5xl">On The Bench</h2>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <div class="reveal rounded-sm border border-white/10 p-6 transition-colors hover:border-accent">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="label text-sm text-paper">{s.name}</h3>
              {s.note && <span class="label text-xs text-accent">{s.note}</span>}
            </div>
            <p class="mt-3 text-sm leading-relaxed text-paper/70">{s.body}</p>
          </div>
        ))}
      </div>
      <p class="reveal mt-8 max-w-prose text-sm leading-relaxed text-paper/70">
        Not listed? Bring it in anyway. If it is something we cannot do, we will say so and point you somewhere that can.
      </p>
    </section>

    <section aria-labelledby="how" class="mt-20 md:mt-28">
      <p class="label reveal text-xs text-accent">How-We-Work.//</p>
      <h2 id="how" class="display grad reveal mt-4 text-3xl md:text-5xl">Before You Drop It Off</h2>
      <dl class="mt-12 grid gap-8 md:grid-cols-3">
        {promises.map((p) => (
          <div class="reveal border-l-2 border-accent pl-4">
            <dt class="label text-sm text-paper">{p.heading}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-paper/70">{p.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- the terms that cover bench work -->
    <section aria-labelledby="terms" class="mt-20 md:mt-28">
      <p class="label reveal text-xs text-accent">The-Fine-Print.//</p>
      <h2 id="terms" class="display grad reveal mt-4 text-3xl md:text-5xl">Service Terms</h2>
      <ul class="reveal mt-10 max-w-3xl list-disc space-y-3 pl-5 text-sm leading-relaxed text-paper/70">
        <li><strong class="text-paper">Back up your data first.</strong> Servicing can require a reinstall or a drive swap. We are not responsible for data lost during a service, so please back up anything you cannot replace before you leave the machine with us.</li>
        <li><strong class="text-paper">Aged and faulty hardware.</strong> A part that is already failing, worn or damaged can give out during or shortly after a service. We will tell you when we can see the risk, but we cannot guarantee the outcome on hardware that was already on its way out.</li>
        <li><strong class="text-paper">Parts you supply.</strong> We will fit them, but they are fitted at your risk and covered by their own manufacturer warranty rather than ours.</li>
        <li><strong class="text-paper">Approval before work.</strong> Nothing is touched until you have the price and have said yes. If the job grows once it is open, we stop and re-quote.</li>
        <li><strong class="text-paper">Diagnostics.</strong> Some faults take time to find. Where a fault cannot be reproduced or traced, we will tell you what we have ruled out rather than guess at a repair.</li>
        <li><strong class="text-paper">Collection.</strong> Please collect finished machines within 30 days. After that we may charge storage.</li>
        <li><strong class="text-paper">Workmanship.</strong> Our work is covered for thirty days - see <a class="text-accent hover:underline" href="/warranty-and-returns">Warranty &amp; Returns</a>. It covers what we did, not the hardware itself.</li>
      </ul>
      <p class="reveal mt-8 max-w-3xl text-sm leading-relaxed text-paper/70">
        These sit alongside our full <a class="text-accent hover:underline" href="/terms-and-conditions">Terms &amp; Conditions</a> and do not affect your rights under the Australian Consumer Law.
      </p>
    </section>

    <div class="reveal mt-20 flex flex-wrap gap-4">
      <a href="/contact" class="label rounded-sm bg-accent px-6 py-3 text-sm font-medium text-ink transition-colors hover:bg-paper focus-visible:outline-2 focus-visible:outline-paper active:translate-y-px">
        Book-It-In
      </a>
    </div>
  </article>

  <style>
    /* headings clip a vertical gradient, muted into paper - as elsewhere */
    .grad {
      background: linear-gradient(180deg, var(--color-muted) 0%, var(--color-paper) 70%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }
  </style>
</Base>
