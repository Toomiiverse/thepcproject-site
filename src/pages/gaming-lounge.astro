---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { currentTournament } from '../data/tournament';
import { aud, site } from '../data/site-config';

const t = currentTournament;

const plans = [
  { name: 'Casual-Pass', price: aud(site.lounge.casualHour), per: 'hour', tag: 'Quick-Session',
    perks: ['One hour in the cafe on a high-performance PC', 'One free drink', 'One free snack'] },
  { name: 'Standard',    price: aud(site.lounge.standardWeek), per: 'week', tag: 'Weekday-Value',
    perks: ['Unlimited cafe time, Monday to Friday, 9am to 6pm', 'One free drink a week', 'One free snack a week'] },
  { name: 'Premium',     price: aud(site.lounge.premiumWeek), per: 'week', tag: 'All-Week',
    perks: ['Unlimited cafe time, all week', 'A free drink and snack every session', '10% off PC parts and services'] },
  { name: 'Ultimate',    price: aud(site.lounge.ultimateWeek), per: 'week', tag: 'Gamers-&-Anime-Fans', featured: true,
    perks: ['Unlimited cafe time, all week', 'A free drink every session', 'A free snack every session', 'Access to our manga library', '10% off PC parts and services'] },
];
const seat = ['High-Performance-PCs', 'Wireless-Gear', 'Fast-Internet', 'Built-For-Gamers'];
const contactUrl = (import.meta.env.PUBLIC_CONTACT_URL as string | undefined)?.trim() ?? '';
---
<Base title="Gaming Lounge | The PC Project">
  <PageHero label="Now-Open.//" heading="Gaming Lounge" video="/video/lounge.mp4" poster="/video/lounge-poster.jpg">
    <p>The only PC gaming lounge of its kind in Northbridge - close to public transport, running the latest games on hardware we built ourselves.</p>
  </PageHero>

  <section class="mx-auto max-w-7xl px-4 pb-24 sm:px-6">
    <!-- ── this month's tournament ──────────────────────────────────
         Always present. With nothing announced it says so, rather than
         disappearing and leaving the page looking like nothing happens
         here. Edit src/data/tournament.ts to change it.            -->
    <section aria-labelledby="tournament-heading" class="reveal rl-panel relative mt-4 overflow-hidden rounded-sm border border-accent/40 bg-white/[0.02] p-6 sm:p-8">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <div>
          <p class="label text-xs text-accent">Tournament.//</p>
          <h2 id="tournament-heading" class="display mt-2 text-3xl md:text-4xl">
            {t ? t.title : 'To be announced'}
          </h2>
        </div>
        <p class="label text-xs text-muted">{t ? t.month : 'Next event'}</p>
      </div>

      {t ? (
        <>
          {t.blurb && <p class="mt-4 max-w-prose text-sm leading-relaxed text-paper/70">{t.blurb}</p>}

          <dl class="mt-6 grid gap-4 sm:grid-cols-3">
            {[
              ['When', t.when],
              ['Format', t.format],
              ['Entry', t.entry],
            ].map(([term, detail]) => (
              <div class="rl-item border-l-2 border-accent pl-4">
                <dt class="label text-xs text-muted">{term}</dt>
                <dd class="mt-1 text-sm leading-relaxed text-paper">{detail}</dd>
              </div>
            ))}
          </dl>

          <h3 class="label mt-8 text-xs text-muted">Prizes</h3>
          <ul class="mt-2 divide-y divide-white/10 border-y border-white/10">
            {t.prizes.map((p) => (
              <li class="rl-item flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3">
                <span class="label text-sm text-accent">{p.place}</span>
                <span class="flex-1 text-sm leading-relaxed text-paper/80">{p.reward}</span>
              </li>
            ))}
          </ul>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={t.signUpUrl ?? '/contact'}
              class="label rounded-sm bg-accent px-6 py-3 text-sm font-medium text-ink transition-colors hover:bg-paper focus-visible:outline-2 focus-visible:outline-paper active:translate-y-px"
            >
              {t.signUpUrl ? 'Sign-Up' : 'Ask-Us-To-Save-You-A-Seat'}
            </a>
          </div>
        </>
      ) : (
        <>
          <p class="mt-4 max-w-prose text-sm leading-relaxed text-paper/70">
            We run competitions in-store through the year - the next one is
            still being put together. Ask us in the shop or get in touch and
            we will tell you the moment a date is set.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="/contact"
              class="label rounded-sm border border-white/20 px-6 py-3 text-sm text-paper transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-accent active:translate-y-px"
            >
              Tell-Me-When
            </a>
          </div>
        </>
      )}
    </section>


    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      <div class="reveal photo aspect-[4/5] overflow-hidden rounded-sm border border-white/10">
        <img src="/images/cafe-play.jpg" alt="Three people playing at adjacent stations in the cafe, headsets on, PCs mounted along the wall above them" loading="lazy" class="h-full w-full object-cover" />
      </div>
      <div class="reveal photo aspect-[4/5] overflow-hidden rounded-sm border border-white/10">
        <img src="/images/cafe-sf6.jpg" alt="Two players side by side at a station, controllers in hand, a fighting game on the monitor" loading="lazy" class="h-full w-full object-cover" />
      </div>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <div class="reveal border-l-2 border-accent pl-4">
        <h2 class="label text-sm text-paper">Latest-Games</h2>
        <p class="mt-2 text-sm leading-relaxed text-paper/70">High-refresh rigs with the current titles installed and ready.</p>
      </div>
      <div class="reveal border-l-2 border-accent pl-4">
        <h2 class="label text-sm text-paper">Esports-Events</h2>
        <p class="mt-2 text-sm leading-relaxed text-paper/70">Regular competitions hosted in-store. Follow us for the next one.</p>
      </div>
      <div class="reveal border-l-2 border-accent pl-4">
        <h2 class="label text-sm text-paper">Easy-To-Reach</h2>
        <p class="mt-2 text-sm leading-relaxed text-paper/70">{site.address.street}, {site.address.suburb} - minutes from public transport.</p>
      </div>
    </div>
    <!-- ── the cafe: memberships ──────────────────────────────── -->
    <section aria-labelledby="pricing-heading" class="mt-16 md:mt-24">
      <p class="label reveal text-xs text-accent">Memberships.//</p>
      <h2 id="pricing-heading" class="display reveal mt-4 text-3xl md:text-5xl">Gaming Cafe Pricing</h2>
      <p class="reveal mt-4 max-w-prose text-sm leading-relaxed text-paper/70">
        Pay by the hour, or take a week and make the place yours. Weekly memberships, no lock-in contracts. Sign up in store.
      </p>

      <div class="reveal mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {plans.map((p) => (
          <article class={`tier flex flex-col rounded-sm border p-6 ${p.featured ? 'tier-featured border-accent' : 'border-white/10'}`}>
            <h3 class="label text-sm text-paper">{p.name}</h3>
            <p class="price mt-4 flex items-baseline gap-2">
              <span class="display text-4xl">{p.price}</span>
              <span class="label text-xs text-muted">/ {p.per}</span>
            </p>
            <ul class="mt-6 space-y-2 border-t border-white/10 pt-6">
              {p.perks.map((k) => (
                <li class="flex gap-2 text-sm leading-relaxed text-paper/70">
                  <span class="text-accent" aria-hidden="true">&#47;&#47;</span><span>{k}</span>
                </li>
              ))}
            </ul>
            <p class="label mt-auto pt-6 text-xs text-accent">{p.tag}</p>
          </article>
        ))}
      </div>

      <!-- what every seat gets -->
      <ul class="reveal mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {seat.map((f) => (
          <li class="label rl-item border-l-2 border-accent pl-4 text-xs text-paper/80">{f}</li>
        ))}
      </ul>

      <p class="reveal mt-8 max-w-prose text-[11px] italic leading-relaxed text-muted">
        Two weeks' notice is required to cancel a membership. Perks are available while a membership is active,
        complimentary drinks and snacks are subject to available stock, and membership benefits are non-transferable.
      </p>
      <div class="reveal mt-8 flex flex-wrap gap-3">
        <a href="#slot-request" class="label rounded-sm bg-accent px-6 py-3 text-sm font-medium text-ink transition-colors hover:bg-paper focus-visible:outline-2 focus-visible:outline-paper active:translate-y-px">
          Request-A-Slot
        </a>
        <a href="/contact" class="label rounded-sm border border-white/20 px-6 py-3 text-sm text-paper transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-accent active:translate-y-px">
          Hours-&-Directions
        </a>
      </div>
    </section>

    <section id="slot-request" aria-labelledby="slot-heading" class="mt-16 md:mt-24">
      <p class="label reveal text-xs text-accent">Book-A-Seat.//</p>
      <h2 id="slot-heading" class="display reveal mt-4 text-3xl md:text-5xl">Request a slot</h2>
      <p class="reveal mt-4 max-w-prose text-sm leading-relaxed text-paper/70">
        Tell us when you want a seat. This is a request — we confirm by email. No live calendar.
      </p>
      <form id="slot-form" class="reveal mt-10 max-w-xl space-y-5" novalidate>
        <input type="checkbox" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
        <label class="block">
          <span class="label text-xs text-muted">Name *</span>
          <input class="mt-2 w-full rounded-sm border border-white/15 bg-ink-2 px-3 py-2 text-base text-paper" type="text" name="name" required autocomplete="name" />
        </label>
        <label class="block">
          <span class="label text-xs text-muted">Email *</span>
          <input class="mt-2 w-full rounded-sm border border-white/15 bg-ink-2 px-3 py-2 text-base text-paper" type="email" name="email" required autocomplete="email" />
        </label>
        <label class="block">
          <span class="label text-xs text-muted">Preferred day</span>
          <input class="mt-2 w-full rounded-sm border border-white/15 bg-ink-2 px-3 py-2 text-base text-paper" type="date" name="day" />
        </label>
        <label class="block">
          <span class="label text-xs text-muted">Notes</span>
          <textarea class="mt-2 w-full rounded-sm border border-white/15 bg-ink-2 px-3 py-2 text-base text-paper" name="notes" rows="3" placeholder="How many seats, game, membership…"></textarea>
        </label>
        <button type="submit" class="label rounded-sm bg-accent px-6 py-3 text-sm font-medium text-ink transition-colors hover:bg-paper focus-visible:outline-2 focus-visible:outline-paper active:translate-y-px">
          Send-Slot-Request
        </button>
        <p class="text-xs leading-relaxed text-muted">Opens a mail to {site.email} if the shop endpoint is not live yet.</p>
      </form>
    </section>
  </section>
  <script define:vars={{ shopEmail: site.email, contactUrl }}>
    const form = document.getElementById('slot-form');
    if (form instanceof HTMLFormElement) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const fd = new FormData(form);
        if (String(fd.get('website') || '')) return;
        const name = String(fd.get('name') || '').trim();
        const email = String(fd.get('email') || '').trim();
        const day = String(fd.get('day') || '').trim();
        const notes = String(fd.get('notes') || '').trim();
        const body = [`Name: ${name}`, `Email: ${email}`, day ? `Preferred day: ${day}` : '', notes ? `Notes: ${notes}` : '']
          .filter(Boolean)
          .join('\n');
        const mailto = `mailto:${shopEmail}?subject=${encodeURIComponent('Lounge slot request')}&body=${encodeURIComponent(body)}`;
        if (contactUrl) {
          try {
            const res = await fetch(contactUrl, {
              method: 'POST',
              headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
              body: JSON.stringify({ name, email, day, notes, kind: 'lounge-slot' }),
            });
            if (res.ok) {
              form.reset();
              form.insertAdjacentHTML('afterend', '<p class="mt-4 text-sm text-paper/80">Request sent. We will confirm by email.</p>');
              return;
            }
          } catch {}
        }
        window.location.href = mailto;
      });
    }
  </script>
</Base>
