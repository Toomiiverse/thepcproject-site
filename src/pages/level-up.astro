---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

// What can be traded back in. Only new parts from the original build.
const parts = ['CPU', 'GPU', 'Motherboard', 'RAM'];

const steps = [
  { num: '01', label: 'Opt-In.//', heading: 'Add It To Your Build', body: 'A flat $100 on top of your build, taken at purchase. It runs for three years from that date.' },
  { num: '02', label: 'Trade.//', heading: 'Bring The Part Back', body: 'Any new part that was in your build - CPU, GPU, motherboard or RAM. Bring it in whenever you are ready to move up.' },
  { num: '03', label: 'Value.//', heading: 'Priced At Market', body: 'We value the part at what it is actually worth on the day, and put that straight toward the upgrade.' },
  { num: '04', label: 'Swap.//', heading: 'No Service Fee', body: 'We do the swap and test the machine, and you pay nothing for the labour. A GPU swap would normally cost $50.' },
];
---
<Base
  title="Level-Up Program | The PC Project"
  description="Three years of upgrades with no service fees. Trade any new CPU, GPU, motherboard or RAM from your build back at market value."
>
  <PageHero label="Trade-Up.//" heading="Level-Up Program">
    <p>$100 once, and for three years you can trade the parts in your build back at market value and put it toward the next one - with no service fees.</p>
  </PageHero>

  <article class="mx-auto max-w-7xl px-4 pb-24 sm:px-6">
    <!-- the shape of it, at a glance -->
    <dl class="grid gap-6 sm:grid-cols-3">
      <div class="reveal border-l-2 border-accent pl-4">
        <dt class="label text-xs text-muted">Costs</dt>
        <dd class="display mt-1 text-3xl">$100</dd>
      </div>
      <div class="reveal border-l-2 border-accent pl-4">
        <dt class="label text-xs text-muted">Runs For</dt>
        <dd class="display mt-1 text-3xl">3 Years</dd>
      </div>
      <div class="reveal border-l-2 border-accent pl-4">
        <dt class="label text-xs text-muted">Service Fees</dt>
        <dd class="display mt-1 text-3xl">None</dd>
      </div>
    </dl>

    <!-- how it works -->
    <section aria-labelledby="how" class="mt-20 md:mt-28">
      <p class="label reveal text-xs text-accent">How-It-Works.//</p>
      <h2 id="how" class="display grad reveal mt-4 text-3xl md:text-5xl">Four Steps</h2>
      <ol class="mt-12 grid gap-12 md:grid-cols-2">
        {steps.map((s) => (
          <li class="reveal">
            <div class="flex items-baseline gap-4">
              <span class="display text-5xl text-accent" aria-hidden="true">{s.num}</span>
              <span class="label text-xs text-muted">{s.label}</span>
            </div>
            <h3 class="display mt-3 text-3xl">{s.heading}</h3>
            <p class="mt-3 max-w-prose text-sm leading-relaxed text-paper/70">{s.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- what is covered -->
    <section aria-labelledby="parts" class="mt-20 md:mt-28">
      <p class="label reveal text-xs text-accent">What-You-Can-Trade.//</p>
      <h2 id="parts" class="display grad reveal mt-4 text-3xl md:text-5xl">Four Parts</h2>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {parts.map((p) => (
          <li class="reveal rounded-sm border border-white/10 p-6">
            <span class="display text-2xl">{p}</span>
          </li>
        ))}
      </ul>
      <p class="reveal mt-8 max-w-prose text-sm leading-relaxed text-paper/70">
        It applies to new parts that were in your original build. QA Approved and customer-supplied parts are
        covered by their own warranty instead - see <a class="text-accent hover:underline" href="/warranty-and-returns">Warranty &amp; Returns</a>.
      </p>
    </section>

    <div class="reveal mt-20 flex flex-wrap gap-4">
      <a href="/configurator" class="label rounded-sm bg-accent px-6 py-3 text-sm font-medium text-ink transition-colors hover:bg-paper focus-visible:outline-2 focus-visible:outline-paper active:translate-y-px">
        Start-A-Build
      </a>
      <a href="/contact" class="label rounded-sm border border-white/20 px-6 py-3 text-sm text-paper transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-accent active:translate-y-px">
        Ask-Us-About-It
      </a>
    </div>
  </article>

  <style>
    /* headings clip a vertical gradient, muted into paper - as on Custom PCs */
    .grad {
      background: linear-gradient(180deg, var(--color-muted) 0%, var(--color-paper) 70%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }
  </style>
</Base>
